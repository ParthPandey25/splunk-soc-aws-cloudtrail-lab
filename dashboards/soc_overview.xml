<dashboard version="1.1" theme="dark">
  <label>Cloud SOC Analyst Incident Monitoring &amp; Threat Detection Dashboard</label>
  <description>Production SOC Monitoring: AWS CloudTrail &amp; VPC Flow Logs aligned to MITRE ATT&amp;CK Framework</description>
  
  <row>
    <panel>
      <single>
        <title>Failed Console Logins (T1110)</title>
        <search>
          <query>index=aws_cloudtrail eventName=ConsoleLogin "errorMessage=Failed authentication" | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[5,20]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Root Logins Without MFA (T1078)</title>
        <search>
          <query>index=aws_cloudtrail eventName=ConsoleLogin "responseElements.ConsoleLogin=Success" ('userIdentity.type'="Root" OR 'additionalEventData.MFAUsed'="No") | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
        <option name="rangeValues">[1]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Privilege Escalations (T1098)</title>
        <search>
          <query>index=aws_cloudtrail eventName IN ("AttachUserPolicy", "AttachRolePolicy", "PutUserPolicy") requestParameters.policyArn="*AdministratorAccess*" | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
        <option name="rangeValues">[1]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Defense Evasion / Log Tampering (T1562)</title>
        <search>
          <query>index=aws_cloudtrail eventName IN ("StopLogging", "DeleteTrail", "DeleteLogGroup", "DeleteBucketPublicAccessBlock") | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
        <option name="rangeValues">[1]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <chart>
        <title>Alert Distribution by MITRE ATT&amp;CK Technique</title>
        <search>
          <query>
            index=aws_cloudtrail 
            | eval technique=case(
                eventName=="ConsoleLogin" AND like(_raw, "%Failed authentication%"), "T1110 - Brute Force",
                eventName=="ConsoleLogin" AND 'userIdentity.type'=="Root", "T1078 - Valid Accounts (Root)",
                eventName IN ("AttachUserPolicy", "PutUserPolicy"), "T1098 - Account Manipulation",
                eventName IN ("StopLogging", "DeleteTrail"), "T1562 - Impair Defenses",
                eventName IN ("DeleteBucketPublicAccessBlock", "PutBucketAcl"), "T1530 - S3 Discovery/Exposure",
                eventName=="AuthorizeSecurityGroupIngress", "T1021 - Remote Services Exposure",
                true(), "Other Telemetry"
              )
            | where technique!="Other Telemetry"
            | stats count by technique
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.chart.showPercent">1</option>
      </chart>
    </panel>
    <panel>
      <table>
        <title>Live Security Incident Alert Queue (Prioritized)</title>
        <search>
          <query>
            index=aws_cloudtrail 
            | eval severity=case(
                eventName=="StopLogging" OR ('userIdentity.type'=="Root" AND eventName=="ConsoleLogin"), "CRITICAL",
                eventName IN ("AttachUserPolicy", "DeleteBucketPublicAccessBlock", "AuthorizeSecurityGroupIngress"), "HIGH",
                true(), "MEDIUM"
              )
            | table _time, severity, eventName, userIdentity.arn, sourceIPAddress, awsRegion
            | sort - _time
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="count">10</option>
      </table>
    </panel>
  </row>
</dashboard>
